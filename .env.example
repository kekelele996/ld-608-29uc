# Compose 项目名（容器名前缀）
COMPOSE_PROJECT_NAME=ground-turn
# 前端宿主机端口（容器内 80）
FRONTEND_PORT=20108
# 后端宿主机端口（容器内 3000）
BACKEND_PORT=21108
# MySQL 宿主机端口（容器内 3306）
DB_PORT=33060
# 数据库名与凭据
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password
# JWT 签名密钥与有效期（小时）
JWT_SECRET=local-dev-secret
JWT_TTL_HOURS=12
